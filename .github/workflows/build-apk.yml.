name: Build VEL Android APK

on:
  push:
    branches: [main, master]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Check Android project
        run: |
          ls -la
          ls -la android-vel
          test -f android-vel/gradlew
          test -f android-vel/settings.gradle.kts

      - name: Build Debug APK with Gradle
        run: |
          chmod +x android-vel/gradlew
          cd android-vel
          ./gradlew assembleDebug --no-daemon --stacktrace

      - name: Upload APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: vel-0.1-debug-apk
          path: android-vel/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
